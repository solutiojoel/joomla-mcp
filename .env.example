# Joomla administrator URL (include /administrator path)
JOOMLA_BASE_URL=https://example.com/administrator

# Joomla admin credentials
JOOMLA_USERNAME=admin
JOOMLA_PASSWORD=your_password_here

# HTTP port (set to 9300 for Docker; overridden by docker-compose.yml)
HTTP_PORT=9300

# Optional: comma-separated module type slugs to hide from Claude
# MODULE_TYPE_BLACKLIST=

# Optional: comma-separated menu item type slugs to hide from Claude
# MENU_ITEM_TYPE_BLACKLIST=

# Optional: comma-separated tool names to disable
# DISABLED_TOOLS=
